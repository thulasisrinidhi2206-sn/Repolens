# ==============================================================================
# RepoLens - Environment Configuration Reference
# ==============================================================================

# Backend Server Port (Default: 3001)
PORT=3001

# Execution Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins for production deployment
# In development, '*' is permitted. For production, specify your extension ID, GitHub, or deployed domain:
# Example: CORS_ORIGIN=chrome-extension://*,https://github.com,https://repolens.example.com
CORS_ORIGIN=*

# GitHub Personal Access Token (Optional but Strongly Recommended)
# Increases GitHub REST API rate limits from 60 requests/hr (anonymous) to 5,000 requests/hr.
# Obtain a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Extension Build Backend URL (Optional)
# Injected at extension build time to point to your live deployed backend API
# Example: REPOLENS_API_URL=https://repolens-backend.onrender.com
REPOLENS_API_URL=http://localhost:3001

# Server configuration
PORT=3001
NODE_ENV=development

# CORS settings
CORS_ORIGIN=*

# GitHub API Configuration (Optional: increases rate limit from 60 req/hr to 5000 req/hr)
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional: Google Gemini API key for AI-powered code review.
# When unset, RepoLens uses the deterministic static analyzer only.
# Never send this key to the Chrome extension.
# GEMINI_API_KEY=your_gemini_api_key_here
